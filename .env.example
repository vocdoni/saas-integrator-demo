# Copy to .env and fill in. docker compose reads this automatically.
ASPNETCORE_ENVIRONMENT=Development

# Vocdoni SaaS API key for your integrator organization (Bearer token).
VOCDONI_BASE_URL=https://saas-api-dev.vocdoni.net
VOCDONI_API_TOKEN=
# Address of the integrator org the API key belongs to. Associations are created as
# managed orgs under it.
VOCDONI_INTEGRATOR_ADDRESS=

# App JWT signing key — use a long random value in real deployments.
JWT_SIGNING_KEY=dev-only-insecure-signing-key-change-me-min-32-chars

# Seeded SuperAdmin (created on first startup).
ADMIN_EMAIL=admin@hoa.local
ADMIN_PASSWORD=change-me
