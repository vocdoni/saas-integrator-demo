# Copy to .env and fill in. docker compose reads this automatically.
ASPNETCORE_ENVIRONMENT=Development

# Vocdoni SaaS API key for your integrator organization (Bearer token).
# Needs the managed:write scope (managed:read too, for e2e.sh's adopt path).
# Point at a saas-backend running the #571 multi-question /processes API (e.g. a local build).
VOCDONI_BASE_URL=http://localhost:8080
VOCDONI_API_TOKEN=
# Vochain chain id of the target backend (e.g. vocdoni/DEV/36). Needed to sign votes on the voting page.
VOCDONI_CHAIN_ID=

# App JWT signing key — use a long random value in real deployments.
JWT_SIGNING_KEY=dev-only-insecure-signing-key-change-me-min-32-chars

# Seeded SuperAdmin (created on first startup).
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=test
